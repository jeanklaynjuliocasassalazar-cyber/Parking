<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayoutAlumno"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AlumnoActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5">

        <LinearLayout
            android:id="@+id/barraSuperiorAlumno"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_alignParentTop="true"
            android:background="#512DA8"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">



            <TextView
                android:id="@+id/txtTituloAlumno"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Inicio"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/fragmentContainerAlumno"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/barraInferiorAlumno"
            android:layout_below="@id/barraSuperiorAlumno"
            android:background="#F5F5F5" />

        <LinearLayout
            android:id="@+id/barraInferiorAlumno"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_alignParentBottom="true"
            android:background="#FFFFFF"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnInicioBottom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgInicioBottom"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Inicio"
                    android:src="@drawable/ic_home"
                    app:tint="#512DA8" />

                <TextView
                    android:id="@+id/txtInicioBottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Inicio"
                    android:textColor="#512DA8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMenuCentro"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgMenuBottom"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="Abrir menú"
                    android:src="@drawable/ic_menu"
                    app:tint="#A0A0A0" />

                <TextView
                    android:id="@+id/txtMenuBottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Menú"
                    android:textColor="#A0A0A0"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSalirBottom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgSalirBottom"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Cerrar sesión"
                    android:src="@drawable/ic_salir"
                    app:tint="#A0A0A0" />

                <TextView
                    android:id="@+id/txtSalirBottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Salir"
                    android:textColor="#A0A0A0"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationViewAlumno"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        app:headerLayout="@layout/header_menu_alumno"
        app:itemHorizontalPadding="20dp"
        app:itemIconTint="#512DA8"
        app:itemTextColor="#333333"
        app:menu="@menu/menu_alumno" />

</androidx.drawerlayout.widget.DrawerLayout>